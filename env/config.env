# ============================================================
# env/config.env — non-secret config, COMMITTED to git
# ============================================================
# Read by every settings group in src/core/settings.py.
# Only values that are REQUIRED or DIFFER from the code defaults are
# set here; commented lines document the defaults without duplicating them.
#
# Real environment variables (compose / ECS) override this file.
# Never put secrets here — they go in hf.env / llm.env / eval.env.
#
# HF_HOME does NOT belong in any env/ file: huggingface_hub reads it from
# the real process environment, which these files don't populate.
# Containers set it in compose; on the host, leave it unset.
# ============================================================

# --- Model registry (required: no code default) ---
MODEL_VERSION=v5

# --- API behaviour (differs from code default "*") ---
CORS_ORIGINS=http://localhost:5173

# --- Defaults (uncomment only to change) ---
# MODEL_REPO=burgerFlipperF/bandit-scorer
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# REDIS_URL=redis://localhost:6379/0
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=600