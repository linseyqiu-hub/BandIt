# BandIt environment variables
# .env is gitignored and dockerignored — it never leaves your machine.
# In compose, service addresses are overridden by compose.yaml's
# environment: block. Only secrets come from .env there.
# On ECS (Step 4), everything comes from Secrets Manager / task definition.

# --- Secrets (required) ---
ANTHROPIC_API_KEY=
HF_TOKEN=

# --- Eval-only secrets (not needed in the container) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Model ---
MODEL_VERSION=v5
MODEL_REPO=burgerFlipperF/bandit-scorer

# --- Services (defaults work for local dev without Docker) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_URL=redis://localhost:6379/0

# --- API behaviour ---
CORS_ORIGINS=http://localhost:5173

# --- Cache (override in Dockerfile / compose) ---
HF_HOME=/models
